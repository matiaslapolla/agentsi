<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AgentSI core, as a launchd user agent.
     packaging/install.sh copies this file to ~/Library/LaunchAgents/ and replaces @BINDIR@ and @HOME@.
     It loads the agent only when the user asks for it (the enable option). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.agentsi.core</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BINDIR@/agentsi-core</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@BINDIR@:@HOME@/.cargo/bin:@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/agentsi-core.log</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/agentsi-core.log</string>
</dict>
</plist>
