# AgentSI core, as a systemd user service.
# packaging/install.sh copies this file to ~/.config/systemd/user/ and replaces @BINDIR@.
# It enables the service only with --enable. By hand: systemctl --user enable --now agentsi-core
[Unit]
Description=AgentSI core
Documentation=https://github.com/matiaslapolla/agentsi

[Service]
Type=simple
ExecStart=@BINDIR@/agentsi-core serve
Restart=on-failure
RestartSec=2
# A client (agentsi, the app) may start a core first. The second core exits with 3.
SuccessExitStatus=3
# The core starts `claude`, `git` and `bwrap` for meetings and stories.
Environment=PATH=@BINDIR@:%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
